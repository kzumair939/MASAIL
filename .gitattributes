* text=auto eol=lf

*.java text
*.ts text
*.tsx text
*.js text
*.jsx text
*.json text
*.yml text
*.yaml text
*.md text
*.sql text

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.jar binary

# GitHub Linguist Overrides
# Exclude frontend TypeScript, TSX, JS, CSS, and HTML from language statistics
# so GitHub recognizes and displays Java as the primary language.

frontend/** linguist-detectable=false
*.ts linguist-detectable=false
*.tsx linguist-detectable=false
*.js linguist-detectable=false
*.jsx linguist-detectable=false
*.css linguist-detectable=false
*.html linguist-detectable=false

